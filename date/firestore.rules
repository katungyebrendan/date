rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      // A viewer who isn't the profile owner may only ever bump their own
      // view/like counter on someone else's doc, by exactly 1 per write, and
      // may not touch any other field in the same write.
      function isCounterIncrement() {
        let before = resource.data;
        let after = request.resource.data;
        return (after.diff(before).affectedKeys().hasOnly(['viewCount'])
                && after.viewCount == before.get('viewCount', 0) + 1)
            || (after.diff(before).affectedKeys().hasOnly(['likeCount'])
                && after.likeCount == before.get('likeCount', 0) + 1);
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.uid == uid;
      allow update: if isSignedIn() && (request.auth.uid == uid || isCounterIncrement());
      allow delete: if isSignedIn() && request.auth.uid == uid;

      match /swipes/{targetUid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == uid
                      && targetUid != uid
                      && request.resource.data.targetUid == targetUid;
        allow update, delete: if false; // write-once, immutable
      }
    }

    // Reservation docs (doc id = normalized phone number) that make a
    // WhatsApp number usable by only one account at a time.
    match /phoneNumbers/{phoneNumber} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /matches/{matchId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && matchId == (
                         request.resource.data.participants[0] < request.resource.data.participants[1]
                           ? request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
                           : request.resource.data.participants[1] + '_' + request.resource.data.participants[0]
                       );
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.participants;
        allow create: if isSignedIn()
                      && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.participants
                      && request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn()
                      && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.participants
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
        allow delete: if false;
      }
    }
  }
}
